FROM docker.io/library/archlinux:latest

RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm --needed \
    base-devel git cmake ninja extra-cmake-modules \
    qt6-base qt6-declarative qt6-multimedia qt6-5compat qt6-imageformats \
    qt6-svg qt6-wayland qt6-shadertools \
    kwindowsystem kguiaddons networkmanager-qt pulseaudio-qt \
    kglobalaccel kconfig kcoreaddons kwin \
    quickshell matugen libqalculate aubio protobuf openssl \
    avahi libx11 wayland ddcutil brightnessctl vulkan-headers

# Create unprivileged build user for makepkg
RUN useradd -m -G wheel -s /bin/bash builder && \
    echo "builder ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

USER builder
WORKDIR /home/builder
